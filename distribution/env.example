# Generated by setup.sh. Do not copy real secrets into git.

# Database. The root password is only for backup, restore, and bootstrap-db.sh.
# The app connects as ARANGO_USER.
ARANGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
ARANGO_PASSWORD=CHANGE_ME_APP_PASSWORD
ARANGO_DB_NAME=knowledgeplane
ARANGO_USER=kp

# Generated on this server by setup.sh.
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
TOKEN_SIGNING_KEY=CHANGE_ME_TOKEN_SIGNING_KEY

# Public name. Caddy terminates HTTPS for this host.
PUBLIC_HOST=knowledge.example.com
APP_URL=https://knowledge.example.com
MCP_SERVER_URL=https://knowledge.example.com/mcp

# At least one sign-in provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra, certificate credential. Paste the PEM with \n for newlines.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_PRIVATE_KEY=

# AI provider used for consolidation, extraction, and embeddings.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Scheduled data sources. Set false for a deployment that only stores facts people ask to save.
DATA_SOURCES_ENABLED=true

# Pinned image tag. kp-load.sh refuses "latest".
DOCKER_REGISTRY=knowledgeplane
IMAGE_VERSION=0.1.0

# Two or more custodian certificates for backup.sh.
CUSTODIAN_CERTS=
