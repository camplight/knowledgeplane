# KnowledgePlane Client Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
ARANGO_PASSWORD=your-secure-password-here
ARANGO_DB_NAME=knowledgeplane
ARANGO_USER=root

# ============================================
# Security & Authentication
# ============================================
# Generate a secure session secret (32+ characters)
# Run: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# API keys for MCP server authentication (comma-separated)
# Generate: openssl rand -hex 16
API_KEYS=your-api-key-here

# ============================================
# OAuth Configuration
# ============================================
# App URL - Top-level URL for the application
# Used for OAuth callbacks, API endpoints, etc.
APP_URL=https://yourdomain.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Application URLs
# ============================================
# MCP Server URL (separate domain)
MCP_SERVER_URL=https://mcp.yourdomain.com

# MCP Server API key (same as API_KEYS above, or a specific key)
MCP_SERVER_API_KEY=your-api-key-here

# ============================================
# AI Provider Configuration
# ============================================
# Provider: openai or anthropic
AI_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Service Ports (optional, defaults shown)
# ============================================
MCP_SERVER_PORT=8080
WEBAPP_PORT=3000

# ============================================
# Storage Configuration (optional)
# ============================================
UPLOADS_DIR=./uploads

# ============================================
# Docker Image Configuration (optional)
# ============================================
# Docker Hub registry/organization (default: knowledgeplane)
# Change if using a different registry or private images
DOCKER_REGISTRY=knowledgeplane

# Image version tag (default: latest)
# Use specific version like v1.0.0 for production
IMAGE_VERSION=latest
