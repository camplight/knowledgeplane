{
  "name": "knowledgeplane",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@knowledgeplane/file-processor": "*",
    "arangojs": "10.2.2",
    "p-queue": "9.1.0"
  },
  "scripts": {
    "bootstrap": "npm install",
    "dev": "concurrently -n \"infra,rest-api,mcp-server,webapp,background-workers\" -c \"blue,cyan,green,yellow,magenta\" \"npm run dev:infra\" \"npm run dev:rest-api\" \"npm run dev:mcp-server\" \"npm run dev:webapp\" \"npm run dev:background-workers\"",
    "dev:clean": "npm run db:reset && npm run dev",
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up",
    "dev:rest-api": "node scripts/wait-for-db.js && npm run dev --workspace=apps/rest-api",
    "dev:mcp-server": "node scripts/wait-for-db.js && npm run dev --workspace=apps/mcp-server",
    "dev:webapp": "npm run dev --workspace=apps/webapp",
    "dev:background-workers": "node scripts/wait-for-db.js && npm run dev --workspace=apps/background-workers",
    "dev:stop": "docker compose -f infra/docker-compose.dev.yml down",
    "lint": "npm run lint --workspace=apps/webapp --if-present",
    "build": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "rebuild": "npm run typecheck && docker compose -f infra/docker-compose.dev.yml down -v && docker compose -f infra/docker-compose.dev.yml up -d && node scripts/wait-for-db.js",
    "db:reset": "node scripts/reset-db.js",
    "bench:quick": "bash scripts/bench-with-stack.sh quick",
    "bench:quick:norerank": "BENCH_SKIP_RERANKER=1 bash scripts/bench-with-stack.sh quick",
    "bench:all": "bash scripts/bench-with-stack.sh all"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "brace-expansion": "1.1.13",
    "brace-expansion-2": "npm:brace-expansion@2.0.3",
    "concurrently": "9.1.0",
    "dotenv-cli": "^11.0.0",
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "minimatch": "5.1.9",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "qs": "6.15.1",
    "rollup": "4.60.3",
    "tsx": "4.22.0",
    "vite": "7.3.3",
    "yaml": "2.9.0"
  },
  "overrides": {
    "ajv": "8.20.0",
    "archiver": "8.0.0",
    "@fastify/ajv-compiler": {
      ".": "4.0.5",
      "ajv": "8.20.0"
    },
    "@fastify/ajv-compiler@4.0.5": {
      "ajv": "8.20.0"
    },
    "ajv-formats": {
      ".": "3.0.1",
      "ajv": "8.20.0"
    },
    "ajv-formats@3.0.1": {
      "ajv": "8.20.0"
    },
    "concurrently": {
      "lodash": "4.18.1"
    },
    "exceljs": {
      "archiver": "8.0.0"
    },
    "fast-json-stringify": {
      ".": "6.4.0",
      "ajv": "8.20.0"
    },
    "fast-json-stringify@6.4.0": {
      "ajv": "8.20.0"
    },
    "fastify": {
      "@fastify/ajv-compiler": "4.0.5",
      "fast-json-stringify": "6.4.0"
    },
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.0.3"
    },
    "@modelcontextprotocol/sdk": {
      "ajv": "8.20.0",
      "ajv-formats": "3.0.1"
    },
    "next": {
      ".": "$next",
      "postcss": "8.5.14"
    },
    "next@16.2.6": {
      "postcss": "8.5.14"
    },
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "qs": "6.15.1",
    "readdir-glob": {
      ".": "1.1.3",
      "minimatch": "5.1.9"
    },
    "readdir-glob@1.1.3": {
      "minimatch": "5.1.9"
    },
    "rollup": "4.60.3",
    "vite": "7.3.3",
    "yaml": "2.9.0"
  }
}
