# DigitalOcean App Platform Environment Variables
# Copy these to your App Platform dashboard for each service

# ============================================
# Common Environment Variables (All Services)
# ============================================

# App URL - Automatically provided by DigitalOcean App Platform as ${APP_URL}
# This is the top-level URL for the application and is used where suitable
# (e.g., OAuth redirects, API endpoints)
APP_URL=${APP_URL}

# ArangoDB Connection (from Droplet)
# Use public IP: http://your-droplet-ip:8529
# Or VPC private IP: http://10.x.x.x:8529
ARANGO_URL=http://your-droplet-ip:8529
ARANGO_DB_NAME=knowledgeplane
ARANGO_USER=root
ARANGO_PASSWORD=your-secure-password-here

# ============================================
# MCP Server Environment Variables
# ============================================

NODE_ENV=production
PORT=8080

# Security
SESSION_SECRET=your-session-secret-here
API_KEYS=your-api-key-here

# OAuth Configuration
# APP_URL is automatically provided by DigitalOcean App Platform
APP_URL=${APP_URL}
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI Provider Configuration
# Workspace settings choose provider/model; set the API keys for the providers your workspaces use.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Anthropic Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Configuration
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_EMBEDDING_MODEL=text-embedding-004

# File Uploads
UPLOADS_DIR=./uploads

# ============================================
# Webapp Environment Variables
# ============================================

NODE_ENV=production

# OAuth Configuration
# APP_URL is automatically provided by DigitalOcean App Platform
APP_URL=${APP_URL}

# MCP Server Configuration
MCP_SERVER_URL=https://your-mcp-server.ondigitalocean.app
MCP_SERVER_API_KEY=your-api-key-here

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI Provider Configuration
# Workspace settings choose provider/model; set the API keys for the providers your workspaces use.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Anthropic Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Configuration
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ============================================
# Background Workers Environment Variables
# ============================================

NODE_ENV=production

# AI Provider Configuration
# Workspace settings choose provider/model; set the API keys for the providers your workspaces use.
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Anthropic Configuration
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Google Configuration
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_EMBEDDING_MODEL=text-embedding-004

# ============================================
# Notes
# ============================================
#
# 1. Store sensitive values (passwords, API keys, secrets) as DigitalOcean Secrets
#    in App Platform dashboard instead of plain environment variables
#
# 2. For VPC networking, use the private IP address instead of public IP:
#    ARANGO_URL=http://10.x.x.x:8529
#
# 3. Generate secure secrets:
#    SESSION_SECRET: openssl rand -base64 32
#    ARANGO_PASSWORD: openssl rand -base64 24
#    API_KEYS: openssl rand -hex 16
#
# 4. Update OAuth redirect URLs after deployment:
#    Google: https://your-mcp-server.ondigitalocean.app/auth/google/callback
#    GitHub: https://your-mcp-server.ondigitalocean.app/auth/github/callback

