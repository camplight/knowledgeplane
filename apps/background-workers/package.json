{
  "name": "knowledgeplane-background-worker",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./card-consolidator": "./src/workers/card-consolidator.ts"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -e .env.dev -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "test": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@knowledgeplane/aimodel": "*",
    "@knowledgeplane/db": "*",
    "adm-zip": "0.5.16",
    "dotenv": "16.4.5",
    "p-queue": "^9.1.0",
    "undici": "7.21.0"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "22.0.0",
    "dotenv-cli": "7.4.2",
    "eslint": "9.0.0",
    "tsx": "4.19.0",
    "typescript": "5.6.3",
    "vitest": "4.0.18"
  }
}
