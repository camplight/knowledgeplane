DATABASE_URL=postgres://postgres:postgres@db:5432/knowledgeplane
PORT=8080
API_KEYS=DEV_API_KEY
EMBEDDINGS_PROVIDER=local  # local|openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004
LOG_LEVEL=debug

# OAuth Configuration
# Option 1: JWKS-based OAuth (recommended for production)
# Use this for OAuth providers like Auth0, Okta, Google, etc.
JWKS_URI=https://your-auth-provider.com/.well-known/jwks.json
OAUTH_ISSUER=https://your-auth-provider.com
OAUTH_AUDIENCE=your-client-id

# Option 2: Secret-based JWT (for development or custom providers)
# Use this if you're using a shared secret for token verification
# JWT_SECRET=your-secret-key-here
# OAUTH_ISSUER=https://your-auth-provider.com
# OAUTH_AUDIENCE=your-client-id
